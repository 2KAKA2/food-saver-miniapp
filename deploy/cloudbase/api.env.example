# 复制这些键值到 CloudBase 云托管版本的“环境变量”中，不要提交真实密钥。
DEPLOY_TARGET=cloudbase
APP_NAME=食尽其用 API
ENVIRONMENT=production
WEB_CONCURRENCY=1
DATABASE_URL=mysql+pymysql://replace-with-user:replace-with-url-encoded-password@replace-with-private-host:3306/food_saver?charset=utf8mb4
REDIS_URL=
REQUIRE_REDIS=false
WECHAT_APP_ID=wx30ddd1061d78b551
WECHAT_APP_SECRET=replace-with-wechat-app-secret
SESSION_TTL_DAYS=30
LEGAL_VERSION=2026-08-17
ALLOW_DEV_LOGIN=false
DEV_LOGIN_SECRET=
ZHIPU_API_KEY=
REQUIRE_AI_KEY=false
ZHIPU_CHAT_MODEL=glm-4.7-flash
ZHIPU_VISION_MODEL=glm-4.6v-flash
SEED_DEMO_DATA=false
ALLOWED_ORIGINS=
ALLOWED_HOSTS=food-saver-api,localhost,127.0.0.1,*.webapps.tcloudbase.com,*.tcloudbase.com,*.app.tcloudbase.com,*.tencentcloudbase.com
LOGIN_RATE_LIMIT=10
AI_RATE_LIMIT=20
