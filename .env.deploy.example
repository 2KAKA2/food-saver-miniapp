# 复制为 .env.deploy，并使用强随机密码。该文件不会被 Git 跟踪。
API_DOMAIN=api.example.com
MYSQL_DATABASE=food_saver
MYSQL_USER=food_saver
MYSQL_PASSWORD=replace-with-url-encoded-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password
REDIS_PASSWORD=replace-with-url-encoded-redis-password
DATABASE_URL=mysql+pymysql://food_saver:replace-with-url-encoded-password@mysql:3306/food_saver?charset=utf8mb4
REDIS_URL=redis://:replace-with-url-encoded-redis-password@redis:6379/0
WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=replace-with-wechat-app-secret
ZHIPU_API_KEY=replace-with-zhipu-api-key
